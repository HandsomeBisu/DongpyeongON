# Firebase Admin SDK (use literal \\n in the private key on Vercel)
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Custom SMTP email verification (server only)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="DPS Team <support@dpsteam.kr>"
# Use a different random value with at least 32 characters.
EMAIL_VERIFICATION_SECRET=

# Spotify application credentials (server only)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Must exactly match a Redirect URI registered in the Spotify Developer Dashboard.
SPOTIFY_REDIRECT_URI=

# Optional override for the built-in NEIS Open API key (server only)
NEIS_API_KEY=

# Category-specific admin access (server only)
ADMIN_USERS_PASSWORD=
ADMIN_MUSIC_PASSWORD=
ADMIN_COMMUNITY_PASSWORD=
# Use a random value with at least 32 characters.
ADMIN_SESSION_SECRET=

# Optional Redis-backed waiting room. Leave disabled until the Redis values are set.
WAITING_ROOM_ENABLED=false
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Use a separate random value with at least 32 characters.
QUEUE_SIGNING_SECRET=
