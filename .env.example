# Firebase Admin SDK (use literal \\n in the private key on Vercel)
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Spotify application credentials (server only)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Category-specific admin access (server only)
ADMIN_USERS_PASSWORD=
ADMIN_MUSIC_PASSWORD=
ADMIN_COMMUNITY_PASSWORD=
# Use a random value with at least 32 characters.
ADMIN_SESSION_SECRET=
