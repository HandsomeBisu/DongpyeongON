rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSchoolAccount() {
      return signedIn()
        && request.auth.token.email is string
        && request.auth.token.email_verified == true
        && request.auth.token.email.matches('^[^@]+@dongpyeong[.]ms[.]kr$');
    }

    function isOwner(userId) {
      return isSchoolAccount() && request.auth.uid == userId;
    }

    function hasRole(role) {
      return isSchoolAccount() && request.auth.token.role == role;
    }

    function isStaff() {
      return hasRole('teacher') || hasRole('admin');
    }

    function hasCompletedProfile() {
      return isSchoolAccount()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.onboardingCompleted == true;
    }

    function validPost() {
      return request.resource.data.title is string
        && request.resource.data.title.size() >= 2
        && request.resource.data.title.size() <= 80
        && request.resource.data.content is string
        && request.resource.data.content.size() >= 5
        && request.resource.data.content.size() <= 5000
        && request.resource.data.category in ['학교생활', '정보공유', '질문', '자유이야기'];
    }

    function validStudentProfile() {
      return request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 20
        && request.resource.data.grade in [1, 2, 3]
        && request.resource.data.classNumber in [1, 2, 3, 4, 5, 6]
        && request.resource.data.studentNumber is int
        && request.resource.data.studentNumber >= 1
        && request.resource.data.studentNumber <= 30
        && request.resource.data.onboardingCompleted == true;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isStaff();
      allow create: if isOwner(userId)
        && request.resource.data.role == 'student'
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email;
      allow update: if isOwner(userId)
        && validStudentProfile()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName', 'photoURL', 'name', 'grade', 'classNumber', 'studentNumber', 'onboardingCompleted', 'updatedAt']);
      allow delete: if hasRole('admin');
    }

    match /posts/{postId} {
      // Community access is temporarily disabled. Trusted Admin SDK routes bypass these rules.
      allow read, write: if false;

      match /comments/{commentId} {
        allow read: if hasCompletedProfile();
        allow write: if false;
      }

      match /likes/{userId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }
    }

    match /reports/{reportId} {
      allow read, write: if false;
    }

    // Suggestions are submitted and read through trusted server routes only.
    match /suggestions/{suggestionId} {
      allow read, write: if false;
    }

    match /songRequests/{requestId} {
      // Daily limits and moderation are enforced by authenticated server routes.
      allow read, write: if false;
    }

    match /emailVerificationChallenges/{userId} {
      // Verification codes are managed only by trusted server routes.
      allow read, write: if false;
    }

    match /emailVerificationIpLimits/{ipHash} {
      allow read, write: if false;
    }
  }
}
