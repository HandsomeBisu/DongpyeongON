rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSchoolAccount() {
      return signedIn()
        && request.auth.token.email is string
        && request.auth.token.email_verified == true
        && request.auth.token.email.matches('^[^@]+@dongpyeong[.]ms[.]kr$');
    }

    function isOwner(userId) {
      return isSchoolAccount() && request.auth.uid == userId;
    }

    function hasRole(role) {
      return isSchoolAccount() && request.auth.token.role == role;
    }

    function isStaff() {
      return hasRole('teacher') || hasRole('admin');
    }

    function validPost() {
      return request.resource.data.title is string
        && request.resource.data.title.size() >= 2
        && request.resource.data.title.size() <= 80
        && request.resource.data.content is string
        && request.resource.data.content.size() >= 5
        && request.resource.data.content.size() <= 5000
        && request.resource.data.category in ['학교생활', '정보공유', '질문', '자유이야기'];
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isStaff();
      allow create: if isOwner(userId)
        && request.resource.data.role == 'student'
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email;
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName', 'photoURL', 'updatedAt']);
      allow delete: if hasRole('admin');
    }

    match /posts/{postId} {
      allow read: if isSchoolAccount() && (resource.data.status == 'published' || isStaff());
      allow create: if isSchoolAccount()
        && validPost()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.status == 'published'
        && request.resource.data.likeCount == 0
        && request.resource.data.commentCount == 0;
      allow update: if isSchoolAccount() && validPost()
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.createdAt == resource.data.createdAt
        && ((resource.data.authorId == request.auth.uid
            && request.resource.data.status in ['published', 'deleted']
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['title', 'content', 'category', 'status', 'updatedAt'])) || isStaff());
      allow delete: if hasRole('admin');

      match /comments/{commentId} {
        allow read: if isSchoolAccount();
        allow write: if false;
      }

      match /likes/{userId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }
    }

    match /reports/{reportId} {
      allow read, write: if false;
    }

    // Suggestions are submitted and read through trusted server routes only.
    match /suggestions/{suggestionId} {
      allow read, write: if false;
    }

    match /songRequests/{requestId} {
      allow read: if isSchoolAccount();
      allow create: if isSchoolAccount()
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if isStaff();
      allow delete: if hasRole('admin');
    }
  }
}
